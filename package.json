{
  "name": "streetmasters",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:development": "vite build --mode development",
    "test:environments": "playwright test --config playwright.environments.config.js",
    "preview": "vite preview",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist",
    "test": "playwright test",
    "build:pages": "vite build --base=/ && node scripts/prepare-pages.mjs",
    "analytics:goals": "node --env-file-if-exists=.env.plausible scripts/sync-plausible-goals.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "gh-pages": "6.1.1",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.2.1"
  }
}
